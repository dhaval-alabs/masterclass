# =============================================================================
# excel-to-ai — Environment Variable Template
# -----------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# NEXT_PUBLIC_* vars are exposed to the browser — keep secrets out of them.
#
# Legend:  [REQUIRED] breaks a feature if missing   ·  [OPTIONAL] has a code
#          fallback   ·  [LEGACY] present in old env but no code reads it
# =============================================================================

# -----------------------------------------------------------------------------
# Core / Site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com           # [REQUIRED] canonical site URL
# NODE_ENV is set automatically by Next.js — do NOT set it here
ALLOWED_ORIGINS=https://your-domain.com                # [OPTIONAL] extra CORS origins (comma-separated), appended to defaults

# -----------------------------------------------------------------------------
# Database (Supabase / Postgres)
# -----------------------------------------------------------------------------
EXCEL_TO_AI_DB_URL=postgresql://user:password@host:5432/dbname   # [REQUIRED] primary DB connection string
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co                # [REQUIRED] Supabase project URL (browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx          # [REQUIRED] Supabase anon/publishable key (browser)
SUPABASE_SECRET_KEY=sb_secret_xxx                                # [REQUIRED] Supabase service-role/secret key (server only)

# -----------------------------------------------------------------------------
# Admin auth
# -----------------------------------------------------------------------------
ADMIN_USER=admin                                       # [REQUIRED] single-admin username
ADMIN_PASSWORD=change-me                               # [REQUIRED] single-admin password
ADMIN_JWT_SECRET=generate-a-long-random-string         # [REQUIRED] signs admin session JWTs
# ADMIN_CREDENTIALS=[{"user":"a","pass":"b"}]          # [OPTIONAL] multi-user JSON; overrides ADMIN_USER/PASSWORD
OTP_HMAC_SECRET=generate-a-long-random-string          # [REQUIRED] HMAC secret for OTP signing

# -----------------------------------------------------------------------------
# Cron (email queue)
# -----------------------------------------------------------------------------
CRON_SECRET=generate-a-long-random-string              # [REQUIRED] bearer token guarding /api/cron/process-email-queue

# -----------------------------------------------------------------------------
# Broadcast API (internal, server-to-server)
# -----------------------------------------------------------------------------
BROADCAST_API_KEY=generate-a-long-random-string        # [REQUIRED for /api/broadcast] Bearer token for programmatic WhatsApp+Email broadcasts. See docs/broadcast-api.md

# -----------------------------------------------------------------------------
# Gemini (lead scoring / qualification)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=AIza...                                 # [REQUIRED] Google Gemini API key
GEMINI_MODEL=gemini-2.0-flash                          # [OPTIONAL] model id; code provides a default

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxx                                  # [REQUIRED] Resend API key
RESEND_FROM_EMAIL=noreply@your-domain.com              # [REQUIRED] verified sender address
# RESEND_FROM_NAME=AnalytixLabs                        # [LEGACY] not read by current code

# -----------------------------------------------------------------------------
# WhatsApp (Meta Cloud API)
# -----------------------------------------------------------------------------
META_WA_ACCESS_TOKEN=EAAxxx                            # [REQUIRED] WhatsApp Cloud API token — used by OTP (sendWhatsAppOtp)
META_WA_PHONE_NUMBER_ID=1234567890                     # [REQUIRED] OTP sender phone-number id
META_WABA_ID=1234567890                                # [REQUIRED] WhatsApp Business Account id
META_WA_WEBHOOK_VERIFY_TOKEN=your-verify-token         # [REQUIRED] echoed back on Meta webhook GET verification
META_WA_WEBHOOK_SECRET=your-app-secret                 # [REQUIRED] verifies inbound webhook signatures (POST)
WA_DAILY_LIMIT=900                                     # [OPTIONAL] server send cap; default 900 (~10% margin under 1,000/24h Tier-1)
NEXT_PUBLIC_WA_DAILY_LIMIT=900                         # [OPTIONAL] client-displayed cap; default 900
WA_SEND_CHUNK=80                                        # [OPTIONAL] recipients per send chunk; 80 fits Vercel Hobby's 60s limit, raise to ~250 on Pro
# Optional dedicated number for BROADCASTS/campaigns (admin test + templates + campaigns).
# When unset, broadcasts fall back to the OTP creds above. Keeps marketing volume
# off the OTP number so it can't hurt OTP deliverability.
# META_WA_BROADCAST_ACCESS_TOKEN=EAAxxx                # [OPTIONAL] token for the broadcast number
# META_WA_BROADCAST_PHONE_NUMBER_ID=1234567890         # [OPTIONAL] broadcast sender phone-number id
# META_WA_BROADCAST_WABA_ID=1234567890                 # [OPTIONAL] broadcast number's WABA id (for template lookup)

# -----------------------------------------------------------------------------
# Meta Conversions API (CAPI) + Pixel
# -----------------------------------------------------------------------------
META_CAPI_ACCESS_TOKEN=EAAxxx                          # [REQUIRED] Meta CAPI access token
META_TEST_EVENT_CODE=TEST12345                         # [OPTIONAL] CAPI test-event code (dev/testing)
META_ATTENDED_EVENT_NAME=WebinarAttended               # [OPTIONAL] event name; default 'WebinarAttended'
NEXT_PUBLIC_META_PIXEL_ID=1234567890                   # [REQUIRED] Meta Pixel id (browser)

# -----------------------------------------------------------------------------
# Zoom (S2S OAuth — webinar + attendance sync)
# -----------------------------------------------------------------------------
ZOOM_ACCOUNT_ID=xxx                                    # [REQUIRED] Zoom Server-to-Server OAuth account id
ZOOM_CLIENT_ID=xxx                                     # [REQUIRED] Zoom S2S client id
ZOOM_CLIENT_SECRET=xxx                                 # [REQUIRED] Zoom S2S client secret
ZOOM_WEBINAR_ID=1234567890                             # [REQUIRED] target webinar id
NEXT_PUBLIC_ZOOM_WEBINAR_URL=https://zoom.us/j/xxx     # [REQUIRED] join URL shown to users (browser)

# -----------------------------------------------------------------------------
# Google Sheets (service account — lead capture sync)
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=svc@project.iam.gserviceaccount.com   # [REQUIRED] service-account email
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"   # [REQUIRED] service-account private key (escaped \n)
GOOGLE_SHEET_ID=1AbC...                                # [REQUIRED] target spreadsheet id

# -----------------------------------------------------------------------------
# LeadSquared (LSQ) CRM
# -----------------------------------------------------------------------------
LSQ_ACCESS=xxx                                         # [REQUIRED] LSQ access key
LSQ_SECRET=xxx                                         # [REQUIRED] LSQ secret key
LSQ_LEAD_SCORE_FIELD=mx_Lead_Score                     # [REQUIRED] schema name for lead-score field
LSQ_NOTES_FIELD_NAME=mx_Notes                          # [REQUIRED] schema name for notes field
LSQ_FBCLID_FIELD=mx_FBCLID                             # [OPTIONAL] schema name for the Meta click-id (FBCLID) field; default mx_FBCLID
LSQ_CHAT_FIELD=mx_Chat_Transcript                      # [OPTIONAL] schema name for the Gemini Q&A transcript field; default mx_Chat_Transcript
LSQ_ATTENDED_FIELD=mx_Attended_Webinar                 # [OPTIONAL] attended flag field; default 'mx_Attended_Webinar'

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX                # [REQUIRED] Google Analytics measurement id (browser)

# -----------------------------------------------------------------------------
# Brochure PDFs (per-course; all fall back to NEXT_PUBLIC_BROCHURE_URL)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BROCHURE_URL=https://www.analytixlabs.co.in/pdf/default.pdf   # [OPTIONAL] fallback brochure; code has a hardcoded default
NEXT_PUBLIC_BROCHURE_AGENTIC_AI=https://.../agentic-ai.pdf                # [OPTIONAL] per-course override
NEXT_PUBLIC_BROCHURE_BUSINESS_ANALYTICS=https://.../business-analytics.pdf # [OPTIONAL]
NEXT_PUBLIC_BROCHURE_DATA_ANALYTICS=https://.../data-analytics.pdf        # [OPTIONAL]
NEXT_PUBLIC_BROCHURE_DATA_SCIENCE=https://.../data-science.pdf            # [OPTIONAL]
NEXT_PUBLIC_BROCHURE_DATA_SCIENCE_PYTHON=https://.../data-science-python.pdf # [OPTIONAL]
NEXT_PUBLIC_BROCHURE_DATA_VISUALIZATION=https://.../data-visualization.pdf  # [OPTIONAL]
NEXT_PUBLIC_BROCHURE_FULL_STACK_AI=https://.../full-stack-ai.pdf          # [OPTIONAL]

# -----------------------------------------------------------------------------
# Legacy / unused — present in old .env.local but no code currently reads these.
# Kept here for reference; safe to delete if the integrations are gone.
# -----------------------------------------------------------------------------
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_REFRESH_TOKEN=
# DISABLE_GADS_UPLOAD=
# SUPABASE_ADMIN_DB_URL=
# EXCEL_TO_AI_DB_PASSWORD=
